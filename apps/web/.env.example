# Crank web — copy to `.env` in this folder for local overrides (optional).

# API origin (no trailing slash). Default in code: http://localhost:7000
VITE_API_BASE_URL=http://localhost:7000

# Google Identity Services — Web client ID (same project as backend GOOGLE_CLIENT_ID).
VITE_GOOGLE_CLIENT_ID=

# GitHub OAuth App — public Client ID only (used for authorize redirect).
# Backend must have GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET, and the callback URL
# registered as: {origin}/auth/github/callback (e.g. http://localhost:5173/auth/github/callback).
VITE_GITHUB_CLIENT_ID=
