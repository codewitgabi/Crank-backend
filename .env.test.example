NODE_ENV=test
PORT=7001

# Use a dedicated test database URI. Keep it separate from dev/prod.
DATABASE_URI_TEST=mongodb://127.0.0.1:27017/crank-backend-test

# Minimal auth config for integration tests
JWT_SECRET=test-jwt-secret
JWT_REFRESH_SECRET=test-jwt-refresh-secret
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Optional for endpoints that send mail
SMTP_HOST=localhost
EMAIL_PORT=1025
EMAIL_USER=test
EMAIL_PASSWORD=test
